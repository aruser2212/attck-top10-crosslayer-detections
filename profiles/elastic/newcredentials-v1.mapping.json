{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "_meta": {
      "profile": "attck-newcredentials-v1",
      "schema_version": 1,
      "timestamp_precision": "microseconds; native 100ns remainder retained in source event identity",
      "event_identity": "immutable event.id is the Elasticsearch _id",
      "session_identity": "observed host.name + trusted upstream host.boot.id + canonical LogonId + local-token SID",
      "observation": "same-session NewCredentials and assigned special privileges, not proof of Pass-the-Hash"
    },
    "dynamic": false,
    "properties": {
      "@timestamp": {"type": "date_nanos", "format": "strict_date_optional_time_nanos"},
      "event": {"properties": {
        "id": {"type": "keyword"}, "dataset": {"type": "keyword"},
        "code": {"type": "keyword"}, "provider": {"type": "keyword"},
        "channel": {"type": "keyword"}, "record_id": {"type": "keyword"},
        "version": {"type": "integer", "coerce": false}
      }},
      "host": {"properties": {
        "name": {"type": "keyword"},
        "boot": {"properties": {"id": {"type": "keyword"}}}
      }},
      "session": {"properties": {"id": {"type": "keyword"}}},
      "user": {"properties": {
        "id": {"type": "keyword"}, "name": {"type": "keyword"}, "domain": {"type": "keyword"}
      }},
      "win": {"properties": {
        "logon_type": {"type": "long", "coerce": false},
        "logon_process": {"type": "keyword"},
        "privileges": {"type": "keyword"},
        "timestamp_remainder": {"type": "integer", "coerce": false}
      }}
    }
  }
}
