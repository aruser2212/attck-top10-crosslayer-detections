{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "_meta": {"profile": "attck-alerts-v1", "schema_version": 1},
    "dynamic": "strict",
    "properties": {
      "@timestamp": {"type": "date"},
      "alert_id": {"type": "keyword"},
      "scope_id": {"type": "keyword"},
      "rule_id": {"type": "keyword"},
      "status": {"type": "keyword"},
      "revision": {"type": "long"},
      "first_detected_at": {"type": "date"},
      "updated_at": {"type": "date"},
      "source_index": {"type": "keyword"},
      "source_index_uuid": {"type": "keyword"},
      "window": {"properties": {"start": {"type": "date"}, "end": {"type": "date"}}},
      "group": {"type": "flattened"},
      "metrics": {"type": "object", "enabled": false}
    }
  }
}
