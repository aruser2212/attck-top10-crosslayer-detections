alert http $EXTERNAL_NET any -> $HOME_NET any ( \
  msg:"HTA content type in HTTP response - phishing-chain hint"; \
  flow:to_client,established; \
  http.content_type; pcre:"/^application\/hta(?:\s*\x3b|\s*$)/i"; \
  classtype:trojan-activity; sid:4204001; rev:2; \
)
alert http $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"HTA path requested over HTTP - phishing-chain hint"; \
  flow:to_server,established; \
  http.uri; pcre:"/^\/[^?]*\.hta(?:\?|$)/i"; \
  classtype:trojan-activity; sid:4204002; rev:2; \
)
