# Suricata 8: connection-rate hint, not an observation of failed authentication.
# The flowbit counts at most one detection match per observed SSH flow.
alert ssh any any -> $HOME_NET 22 ( \
  msg:"High observed SSH flow rate - correlate with authentication logs"; \
  flow:to_server,established; \
  flowbits:isnotset,attck_ssh_flow_counted; \
  flowbits:set,attck_ssh_flow_counted; \
  detection_filter:track by_src, count 10, seconds 60; \
  classtype:attempted-admin; \
  sid:4203001; rev:2; \
)
